        pWire = slMode[ff] > 0.5
        pPos = Vec(slXF[ff * 6 + 0.0], slXF[ff * 6 + 1.0], slXF2[ff * 4 + 0.0])
        pRot = Vec(slXF2[ff * 4 + 1.0], slXF2[ff * 4 + 2.0], slXF[ff * 6 + 2.0])
