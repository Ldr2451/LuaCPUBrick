      DisplayText(ctrl, "█", positionX = qx54, positionY = qy54, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx54], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx54)
      let sp55 = if s + 55.0 >= NPF then s + 55.0 - NPF else s + 55.0
      let sy55 = ((sp55 / SWF) | 0)
      let sx55 = ((sp55 - (sy55 + 0.0) * SWF) | 0)
      let sidx55 = (sp55 | 0)
      let qx55 = if cornerAX < 0.5 then MGX + (sx55 + 0.0) * CELL else 0.0 - (MGX + (sx55 + 0.0) * CELL)
      let qy55 = if cornerAY < 0.5 then MGY + (sy55 + 0.0) * CELL else 0.0 - (MGY + (sy55 + 0.0) * CELL)
      DisplayText(ctrl, "█", positionX = qx55, positionY = qy55, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx55], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx55)
      let sp56 = if s + 56.0 >= NPF then s + 56.0 - NPF else s + 56.0
      let sy56 = ((sp56 / SWF) | 0)
      let sx56 = ((sp56 - (sy56 + 0.0) * SWF) | 0)
