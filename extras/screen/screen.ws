            rowSlope = (umxc - cLo) * inv
            zLo = umnz
            zSlope = (umxz - zLo) * inv
            cLo = Color(cLo.r * bf, cLo.g * bf, cLo.b * bf, cLo.a)
            rowSlope = Color(rowSlope.r * bf, rowSlope.g * bf, rowSlope.b * bf, rowSlope.a)
