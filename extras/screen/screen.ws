      s = if s + 64.0 >= NPF then s + 64.0 - NPF else s + 64.0
      if sweepLeft > 0.0 {
        sweepLeft = sweepLeft - 64.0
      }
    }
  }
}

on Clock(interval = 0.01) {
  paintTick()
}
