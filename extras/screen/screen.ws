      DisplayText(ctrl, "█", positionX = qx56, positionY = qy56, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx56], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx56)
      let sp57 = if s + 57.0 >= NPF then s + 57.0 - NPF else s + 57.0
      let sy57 = ((sp57 / SWF) | 0)
