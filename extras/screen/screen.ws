// Rect-fill pixel screen, 64x64, 64 painter lanes.  GENERATED by
// gen.py -- edit the generator, not this file.  No output ports: pixels
// are DisplayText overlays with stable textIds, repainted in place.
//
// Protocol: pushRect latches the rect, redraw paints it.  Two signals so
// the CPU can write its params across ticks and commit atomically.
// posLeft/posUp pick the anchor corner as screen fractions (0 = left/top,
// 1 = right/bottom -- the documented anchor/offset placement), and every
// pixel offsets INWARD from it in slate units (~pixels at 1080p).  Anchors
// are absolute, so orientation cannot mirror, and a 20 + 63*10 = 650-unit
// grid fits a 1080p screen from any corner.
// persistAll=true keeps a keepalive sweep running so pixels never expire;
// persistAll=false re-shows the frame once per input update and lets it
// expire after LIFE.
//
// Tuning (all consts, top of gen.py): MGX/MGY/CELL place and size the grid,
// FSIZE should match CELL, TIDB must not collide with other overlays,
// LIFE must exceed a full keepalive sweep (4096/K ticks).
// One chip shows to ONE player: wire that viewer's character in.

@layout("cube")

const SW = 64
const SH = 64
const NP = 4096
const SWF = 64.0
const MGX = 20.0
const MGY = 20.0
const CELL = 10.0
const FSIZE = 10
const TIDB = 1000
const LIFE = 10.0
const LANES = 64
const NPF = 4096.0

@left in player: character
@left in rectColor: color
@left in rX0: float
@left in rY0: float
@left in rX1: float
@left in rY1: float
@left in pushRect: bool
@left in redraw: bool
@left in posLeft: bool
@left in posUp: bool
@left in persistAll: bool

var fb: color[]
var fbInit: bool = false
var ctrl: controller
var pCol: color = Color(1.0, 1.0, 1.0, 1.0)
var pX0: float = 0.0
var pY0: float = 0.0
var pX1: float = 0.0
var pY1: float = 0.0
var pending: bool = false
var rectOn: bool = false
var lt: float = 0.0
var area: float = 0.0
var rw: float = 1.0
var cx0: float = 0.0
var cy0: float = 0.0
var s: float = 0.0
var sweepLeft: float = 0.0
var cornerAX: float = 0.0
var cornerAY: float = 0.0
var persistAllV: bool = false

// No prev-edge flags anywhere in this file, deliberately.  on Change fires
// only on a transition, so the event IS the edge and `if pushRect` latches
// exactly on rising.  An earlier version kept `prevRefresh`/`prevRedraw`
// with a write-after tail (`prevRefresh = refresh`), and the tail won the
// race: it executed before the branch re-read the flag, so every real edge
// evaluated false and refresh never latched.  A same-handler read-then-write
// of one var is the shape to never write; cross-handler (pending, rectOn)
// is fine, because no pass writes what it reads.
on Change(pushRect) {
  if pushRect {
    pCol = rectColor
    pX0 = rX0
    pY0 = rY0
    pX1 = rX1
    pY1 = rY1
    cornerAX = if posLeft then 0.0 else 1.0
    cornerAY = if posUp then 0.0 else 1.0
    pending = true
    if !persistAllV {
      sweepLeft = NPF
    }
  }
}

on Change(persistAll) {
  persistAllV = persistAll
}

on Change(redraw) {
  if redraw && pending && !rectOn {
    cornerAX = if posLeft then 0.0 else 1.0
    cornerAY = if posUp then 0.0 else 1.0
    let ax0 = if pX0 < pX1 then pX0 else pX1
    let ax1 = if pX0 < pX1 then pX1 else pX0
    let ay0 = if pY0 < pY1 then pY0 else pY1
    let ay1 = if pY0 < pY1 then pY1 else pY0
    if ax1 < 0.0 || ax0 >= SWF || ay1 < 0.0 || ay0 >= SWF {
      pending = false
      if !persistAllV {
        sweepLeft = NPF
      }
    } else {
      cx0 = if ax0 < 0.0 then 0.0 else if ax0 >= SWF then SWF - 1.0 else ax0
      cy0 = if ay0 < 0.0 then 0.0 else if ay0 >= SWF then SWF - 1.0 else ay0
      let ex1 = if ax1 < 0.0 then 0.0 else if ax1 >= SWF then SWF - 1.0 else ax1
      let ey1 = if ay1 < 0.0 then 0.0 else if ay1 >= SWF then SWF - 1.0 else ay1
      rw = ex1 - cx0 + 1.0
      area = rw * (ey1 - cy0 + 1.0)
      lt = 0.0
      rectOn = true
      pending = false
      if !persistAllV {
        sweepLeft = NPF
      }
    }
  }
}

// Array reads and DisplayText live in a mod, not the handler body: the
// compiler reports both as WS007 outside an exec context, and a mod
// containing DisplayText calls is the shape the compiler's own 2048
// example uses (its renderCell).  There is no % operator, so remainders
// are floor-based (all values here are non-negative, so truncation is
// floor) and the sweep cursor wraps by subtract, one step being < NP.
mod paintTick() {
  if !fbInit {
    // Opaque white: the grid reads as a screen, not a hole, and a
    // first rect shows against it without needing a clear first.
    fb.resize(NP, Color(1.0, 1.0, 1.0, 1.0))
    fbInit = true
  }
  ctrl = ControllerOf(player)
  if rectOn {
    let tt0 = lt + 0.0
    if tt0 < area {
      let qd0 = (((tt0 / rw) | 0) + 0.0)
      let lx0 = cx0 + (tt0 - qd0 * rw)
      let ly0 = cy0 + qd0
      let ridx0 = ((ly0 * SWF + lx0) | 0)
      fb[ridx0] = pCol
      let ox0 = if cornerAX < 0.5 then MGX + lx0 * CELL else 0.0 - (MGX + lx0 * CELL)
      let oy0 = if cornerAY < 0.5 then MGY + ly0 * CELL else 0.0 - (MGY + ly0 * CELL)
      DisplayText(ctrl, "█", positionX = ox0, positionY = oy0, anchorX = cornerAX, anchorY = cornerAY, fontColor = pCol, fontSize = FSIZE, lifetime = LIFE, textId = TIDB + ridx0)
    }
    let tt1 = lt + 1.0
    if tt1 < area {
      let qd1 = (((tt1 / rw) | 0) + 0.0)
      let lx1 = cx0 + (tt1 - qd1 * rw)
      let ly1 = cy0 + qd1
      let ridx1 = ((ly1 * SWF + lx1) | 0)
      fb[ridx1] = pCol
      let ox1 = if cornerAX < 0.5 then MGX + lx1 * CELL else 0.0 - (MGX + lx1 * CELL)
      let oy1 = if cornerAY < 0.5 then MGY + ly1 * CELL else 0.0 - (MGY + ly1 * CELL)
      DisplayText(ctrl, "█", positionX = ox1, positionY = oy1, anchorX = cornerAX, anchorY = cornerAY, fontColor = pCol, fontSize = FSIZE, lifetime = LIFE, textId = TIDB + ridx1)
    }
    let tt2 = lt + 2.0
