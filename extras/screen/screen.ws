// No prev-edge flags anywhere in this file, deliberately.  on Change fires
// only on a transition, so the event IS the edge.  A same-handler
// read-then-write of one var loses the race; cross-handler flags
// (pending, arming, polyOn) are fine, because no pass writes what it reads.
// A push stages colour, mode and slot, and aborts anything live -- a
// burst, a recomposite, a staged arm -- so the next drawAllShapes always
// starts fresh from the new stage.  (A load-time edge on an unwired
// port stages zeroes: an empty immediate shape, which paints nothing.)
on Change(pushShape) {
  if pushShape {
    pWire = shapeWireMode
    pId = if shapeId < 0.0 then 0.0 else if shapeId > 8.0 then 8.0 else (shapeId | 0)
    pPos = shapePosition
    pRot = shapeRotation
    pScl = shapeScale
    pParent = if parentShapeId < 0.0 then 0.0 else if parentShapeId > 8.0 then 8.0 else (parentShapeId | 0)
    pTicks = if addToShapeInTicks < -0.5 then -1.0 else if addToShapeInTicks < 1.0 then 0.0 else (addToShapeInTicks | 0)
    pIs3 = if shapePoints.length() - ((shapePoints.length() / 2.0) | 0) * 2.0 > 0.5 then 1.0 else 0.0
    pending = true
    qPush = true
    polyOn = false
    sOn = false
    rcOn = false
    brightRC = false
    clearing = false
    fromSlot = false
    arming = false
    armingS = false
    commitR = false
    commitQ = false
  }
}

// A bare drawAllShapes replays the last shape: the edge records (fill) or the
// preserved points (stroke) are still staged, so only the walk state
// resets.  Each replay is guarded against the other walk and every arm,
// so a fill burst and a stroke replay can never collide.  A staged
// retained push commits instead: the slot is stored and the wall is
// recomposited from every live slot in order.  A staged clearAllShapes fill
// (blackPending) runs here first: with a shape staged, the fill runs
// and the shape re-arms when it ends (pending is left set on purpose);
// with nothing staged, the wall simply goes black.
on Change(drawAllShapes) {
  if drawAllShapes {
    if blackPending {
      blackPending = false
      clearing = true
      fromSlot = true
      arming = true
      if pending {
        justCleared = true
      }
    } else if pending {
      pending = false
      if qCount > 1.5 {
        commitQ = true
      } else if pId >= 1.0 {
        commitR = true
        qCount = 0.0
      } else {
        if pWire {
          armingS = true
        } else {
          arming = true
        }
        qCount = 0.0
      }
    } else if animDirty {
      commitR = true
      recompOnly = true
    }
    if polyLive && !polyOn && !arming && !sOn && !armingS && !commitR && !commitQ {
      prow = pfirst - 4.0
      pcol = 200.0
      polyOn = true
    }
    if sLive && !sOn && !armingS && !polyOn && !arming && !commitR && !commitQ {
      rX0 = sPx0
      rY0 = sPy0
      rZ0 = sPz0
      rC0 = sPc0
      rX1 = sPx1
      rY1 = sPy1
      rZ1 = sPz1
      rC1 = sPc1
      rX2 = sPx2
      rY2 = sPy2
      rZ2 = sPz2
      rC2 = sPc2
      rX3 = sPx3
      rY3 = sPy3
      rZ3 = sPz3
      rC3 = sPc3
      rX4 = sPx4
      rY4 = sPy4
      rZ4 = sPz4
      rC4 = sPc4
      rX5 = sPx5
      rY5 = sPy5
      rZ5 = sPz5
      rC5 = sPc5
      rX6 = sPx6
      rY6 = sPy6
      rZ6 = sPz6
      rC6 = sPc6
      rX7 = sPx7
      rY7 = sPy7
      rZ7 = sPz7
      rC7 = sPc7
      rX8 = sPx8
      rY8 = sPy8
      rZ8 = sPz8
      rC8 = sPc8
      rX9 = sPx9
      rY9 = sPy9
      rZ9 = sPz9
      rC9 = sPc9
      rX10 = sPx10
      rY10 = sPy10
      rZ10 = sPz10
      rC10 = sPc10
      rX11 = sPx11
      rY11 = sPy11
      rZ11 = sPz11
      rC11 = sPc11
      rX12 = sPx12
      rY12 = sPy12
      rZ12 = sPz12
      rC12 = sPc12
      rX13 = sPx13
      rY13 = sPy13
      rZ13 = sPz13
      rC13 = sPc13
      rX14 = sPx14
      rY14 = sPy14
      rZ14 = sPz14
      rC14 = sPc14
      rX15 = sPx15
      rY15 = sPy15
      rZ15 = sPz15
      rC15 = sPc15
      sSeg = -1.0
      prow = 0.0
      sLast = -1.0
      pcol = 200.0
      sOn = true
    }
  }
}

// brightness is a live dimmer, not staged paint: its edge reruns
// the retained recomposite WITHOUT the black clear (nothing moved,
// so overwriting is pixel-exact -- no flash), and the replay
// block at the iterator's end refreshes the last immediate shape
// the same way -- except the recomposite repaints through the
// same walks, so a brightness pass snapshots the armed immediate
// parameters when it starts and restores them before the replay.
// The wall follows within one recomposite, with no
// drawAllShapes and no restaging; live bursts and recomposites serialize
// ahead of it (their remaining rows already read the new factor
// per row), and rapid twiddles collapse into one repaint that
// always reads the latest value.  An empty wall costs two quiet
// ticks and no paint.
on Change(brightness) {
  if !rcOn {
    rcOn = true
    rcSlot = 1.0
    brightRC = true
  }
}

// clearAllShapes forgets every retained slot and stages a black
// fill -- it does NOT touch the wall itself.  The next
// drawAllShapes runs the staged fill (64 rows, the physical
// floor for 4096 pixels), so a driver can clear memory
// and compose the next image before anything changes on
// screen.  Afterwards no replay can resurrect anything
// (both live flags die here), and the next retained
// commit starts from an empty table.  Pulse it like a
// push: only the rising edge matters.
on Change(clearAllShapes) {
  if clearAllShapes {
    pending = false
    commitR = false
    arming = false
    armingS = false
    polyOn = false
    polyLive = false
    sOn = false
    sLive = false
    rcOn = false
    brightRC = false
    slLive[0] = 0.0
    slLive[1] = 0.0
    slLive[2] = 0.0
    slLive[3] = 0.0
    slLive[4] = 0.0
    slLive[5] = 0.0
    slLive[6] = 0.0
    slLive[7] = 0.0
    slLive[8] = 0.0
    anTicks[0] = 0.0
    anTicks[1] = 0.0
    anTicks[2] = 0.0
    anTicks[3] = 0.0
    anTicks[4] = 0.0
    anTicks[5] = 0.0
    anTicks[6] = 0.0
    anTicks[7] = 0.0
    qCount = 0.0
    blackPending = true
    justCleared = false
  }
}

// Array writes live in a mod, not the handler body: the compiler reports
// array index access outside an exec context as WS007.  There is no %
// operator, so remainders are floor-based (all values here are
// non-negative, so truncation is floor).
mod paintTick() {
  if !fbInit {
    fb.resize(NP, Color(0.0, 0.0, 0.0, 1.0))
    fbZ.resize(NP, ZBACK)
    shPts.resize(32, 0.0)
    shPz.resize(16, 0.0)
    slPts.resize(256, 0.0)
    slPC.resize(128, Color(1.0, 1.0, 1.0, 1.0))
    slXF.resize(48, 0.0)
    slMode.resize(8, 0.0)
    slLive.resize(8, 0.0)
    slCount.resize(8, 0.0)
    slIs3.resize(8, 0.0)
    slPts.resize(288, 0.0)
    slPC.resize(144, Color(1.0, 1.0, 1.0, 1.0))
    slXF.resize(54, 0.0)
    slXF2.resize(36, 0.0)
    covMin.resize(64, 200.0)
    covMax.resize(64, -200.0)
    oldMin.resize(64, 200.0)
    oldMax.resize(64, -200.0)
    anPts.resize(288, 0.0)
    anCol.resize(144, Color(0.0, 0.0, 0.0, 0.0))
    anXF.resize(54, 0.0)
    anXF2.resize(36, 0.0)
    anTicks.resize(9, 0.0)
    qTicks.resize(8, 0.0)
    qCN.resize(8, 0.0)
    slMode.resize(9, 0.0)
    slLive.resize(9, 0.0)
    slCount.resize(9, 0.0)
    slIs3.resize(9, 0.0)
    qN.resize(8, 0.0)
    qIs3.resize(8, 0.0)
    qPts.resize(256, 0.0)
    qCol.resize(128, Color(1.0, 1.0, 1.0, 1.0))
    qXF.resize(48, 0.0)
    qXF2.resize(32, 0.0)
    qMode.resize(8, 0.0)
    qId.resize(8, 0.0)
    fbInit = true
  }
  let bclamp = if brightness < 1.0 then 1.0
    else if brightness > 100.0 then 100.0 else brightness
  bf = if brightness <= 0.0 then DEF_BRIGHT
    else bclamp * FULL_BRIGHT / 100.0
  if pending && (pTicks > 0.5 || pTicks < -0.5) && !clearing {
    let anN = (shapePoints.length() / (if pIs3 > 0.5 then 3.0 else 2.0)) | 0
    if anN < (if pWire then 2.0 else 3.0) {
      pending = false
      let slot = (pId - 1.0) | 0
      for aslot in 0..8 {
        if aslot == slot {
          anTicks[aslot] = pTicks
          let ab = aslot * 32.0
          anPts[ab + 0.0] = 0.0
          anPts[ab + 1.0] = 0.0
          anPts[ab + 2.0] = 0.0
          anPts[ab + 3.0] = 0.0
          anPts[ab + 4.0] = 0.0
          anPts[ab + 5.0] = 0.0
          anPts[ab + 6.0] = 0.0
          anPts[ab + 7.0] = 0.0
          anPts[ab + 8.0] = 0.0
          anPts[ab + 9.0] = 0.0
          anPts[ab + 10.0] = 0.0
          anPts[ab + 11.0] = 0.0
          anPts[ab + 12.0] = 0.0
          anPts[ab + 13.0] = 0.0
          anPts[ab + 14.0] = 0.0
          anPts[ab + 15.0] = 0.0
          anPts[ab + 16.0] = 0.0
          anPts[ab + 17.0] = 0.0
          anPts[ab + 18.0] = 0.0
          anPts[ab + 19.0] = 0.0
          anPts[ab + 20.0] = 0.0
          anPts[ab + 21.0] = 0.0
          anPts[ab + 22.0] = 0.0
          anPts[ab + 23.0] = 0.0
          anPts[ab + 24.0] = 0.0
          anPts[ab + 25.0] = 0.0
          anPts[ab + 26.0] = 0.0
          anPts[ab + 27.0] = 0.0
          anPts[ab + 28.0] = 0.0
          anPts[ab + 29.0] = 0.0
          anPts[ab + 30.0] = 0.0
          anPts[ab + 31.0] = 0.0
          let ax = aslot * 6.0
          let ax2 = aslot * 4.0
          anXF[ax + 0.0] = pPos.x
          anXF[ax + 1.0] = pPos.y
          anXF[ax + 2.0] = pRot.z
          anXF[ax + 3.0] = pScl.x
          anXF[ax + 4.0] = pScl.y
          anXF2[ax2 + 0.0] = pPos.z
          anXF2[ax2 + 1.0] = pRot.x
          anXF2[ax2 + 2.0] = pRot.y
          anXF2[ax2 + 3.0] = pScl.z
          animDirty = true
        }
      }
    }
  }

  if (anTicks[0.0] > 0.5 || anTicks[0.0] < -0.5) && !rcOn {
    if anTicks[0.0] > 0.5 { anTicks[0.0] = anTicks[0.0] - 1.0 }
    animDirty = true
    slPts[0] = slPts[0] + anPts[0]
    slPts[1] = slPts[1] + anPts[1]
    slPts[2] = slPts[2] + anPts[2]
    slPts[3] = slPts[3] + anPts[3]
    slPts[4] = slPts[4] + anPts[4]
    slPts[5] = slPts[5] + anPts[5]
    slPts[6] = slPts[6] + anPts[6]
    slPts[7] = slPts[7] + anPts[7]
    slPts[8] = slPts[8] + anPts[8]
    slPts[9] = slPts[9] + anPts[9]
    slPts[10] = slPts[10] + anPts[10]
    slPts[11] = slPts[11] + anPts[11]
    slPts[12] = slPts[12] + anPts[12]
    slPts[13] = slPts[13] + anPts[13]
    slPts[14] = slPts[14] + anPts[14]
    slPts[15] = slPts[15] + anPts[15]
    slPts[16] = slPts[16] + anPts[16]
    slPts[17] = slPts[17] + anPts[17]
    slPts[18] = slPts[18] + anPts[18]
    slPts[19] = slPts[19] + anPts[19]
    slPts[20] = slPts[20] + anPts[20]
    slPts[21] = slPts[21] + anPts[21]
    slPts[22] = slPts[22] + anPts[22]
    slPts[23] = slPts[23] + anPts[23]
    slPts[24] = slPts[24] + anPts[24]
    slPts[25] = slPts[25] + anPts[25]
    slPts[26] = slPts[26] + anPts[26]
    slPts[27] = slPts[27] + anPts[27]
    slPts[28] = slPts[28] + anPts[28]
    slPts[29] = slPts[29] + anPts[29]
    slPts[30] = slPts[30] + anPts[30]
    slPts[31] = slPts[31] + anPts[31]
    slPC[0] = slPC[0] + anCol[0]
    slPC[1] = slPC[1] + anCol[1]
    slPC[2] = slPC[2] + anCol[2]
    slPC[3] = slPC[3] + anCol[3]
    slPC[4] = slPC[4] + anCol[4]
    slPC[5] = slPC[5] + anCol[5]
    slPC[6] = slPC[6] + anCol[6]
    slPC[7] = slPC[7] + anCol[7]
    slPC[8] = slPC[8] + anCol[8]
    slPC[9] = slPC[9] + anCol[9]
    slPC[10] = slPC[10] + anCol[10]
    slPC[11] = slPC[11] + anCol[11]
    slPC[12] = slPC[12] + anCol[12]
    slPC[13] = slPC[13] + anCol[13]
    slPC[14] = slPC[14] + anCol[14]
    slPC[15] = slPC[15] + anCol[15]
    slXF[0] = slXF[0] + anXF[0]
    slXF[1] = slXF[1] + anXF[1]
    slXF[2] = slXF[2] + anXF[2]
    slXF[3] = slXF[3] + anXF[3]
    slXF[4] = slXF[4] + anXF[4]
    slXF2[0] = slXF2[0] + anXF2[0]
    slXF2[1] = slXF2[1] + anXF2[1]
    slXF2[2] = slXF2[2] + anXF2[2]
    slXF2[3] = slXF2[3] + anXF2[3]
  }
  if (anTicks[1.0] > 0.5 || anTicks[1.0] < -0.5) && !rcOn {
    if anTicks[1.0] > 0.5 { anTicks[1.0] = anTicks[1.0] - 1.0 }
    animDirty = true
    slPts[32] = slPts[32] + anPts[32]
    slPts[33] = slPts[33] + anPts[33]
    slPts[34] = slPts[34] + anPts[34]
    slPts[35] = slPts[35] + anPts[35]
    slPts[36] = slPts[36] + anPts[36]
    slPts[37] = slPts[37] + anPts[37]
    slPts[38] = slPts[38] + anPts[38]
    slPts[39] = slPts[39] + anPts[39]
    slPts[40] = slPts[40] + anPts[40]
    slPts[41] = slPts[41] + anPts[41]
    slPts[42] = slPts[42] + anPts[42]
    slPts[43] = slPts[43] + anPts[43]
    slPts[44] = slPts[44] + anPts[44]
    slPts[45] = slPts[45] + anPts[45]
    slPts[46] = slPts[46] + anPts[46]
    slPts[47] = slPts[47] + anPts[47]
    slPts[48] = slPts[48] + anPts[48]
    slPts[49] = slPts[49] + anPts[49]
    slPts[50] = slPts[50] + anPts[50]
    slPts[51] = slPts[51] + anPts[51]
    slPts[52] = slPts[52] + anPts[52]
    slPts[53] = slPts[53] + anPts[53]
    slPts[54] = slPts[54] + anPts[54]
    slPts[55] = slPts[55] + anPts[55]
    slPts[56] = slPts[56] + anPts[56]
    slPts[57] = slPts[57] + anPts[57]
    slPts[58] = slPts[58] + anPts[58]
    slPts[59] = slPts[59] + anPts[59]
    slPts[60] = slPts[60] + anPts[60]
    slPts[61] = slPts[61] + anPts[61]
    slPts[62] = slPts[62] + anPts[62]
    slPts[63] = slPts[63] + anPts[63]
    slPC[16] = slPC[16] + anCol[16]
    slPC[17] = slPC[17] + anCol[17]
    slPC[18] = slPC[18] + anCol[18]
    slPC[19] = slPC[19] + anCol[19]
    slPC[20] = slPC[20] + anCol[20]
    slPC[21] = slPC[21] + anCol[21]
    slPC[22] = slPC[22] + anCol[22]
    slPC[23] = slPC[23] + anCol[23]
    slPC[24] = slPC[24] + anCol[24]
    slPC[25] = slPC[25] + anCol[25]
    slPC[26] = slPC[26] + anCol[26]
    slPC[27] = slPC[27] + anCol[27]
    slPC[28] = slPC[28] + anCol[28]
    slPC[29] = slPC[29] + anCol[29]
    slPC[30] = slPC[30] + anCol[30]
    slPC[31] = slPC[31] + anCol[31]
    slXF[6] = slXF[6] + anXF[6]
    slXF[7] = slXF[7] + anXF[7]
    slXF[8] = slXF[8] + anXF[8]
    slXF[9] = slXF[9] + anXF[9]
    slXF[10] = slXF[10] + anXF[10]
    slXF2[4] = slXF2[4] + anXF2[4]
    slXF2[5] = slXF2[5] + anXF2[5]
    slXF2[6] = slXF2[6] + anXF2[6]
    slXF2[7] = slXF2[7] + anXF2[7]
  }
  if (anTicks[2.0] > 0.5 || anTicks[2.0] < -0.5) && !rcOn {
    if anTicks[2.0] > 0.5 { anTicks[2.0] = anTicks[2.0] - 1.0 }
    animDirty = true
    slPts[64] = slPts[64] + anPts[64]
    slPts[65] = slPts[65] + anPts[65]
    slPts[66] = slPts[66] + anPts[66]
    slPts[67] = slPts[67] + anPts[67]
    slPts[68] = slPts[68] + anPts[68]
    slPts[69] = slPts[69] + anPts[69]
    slPts[70] = slPts[70] + anPts[70]
    slPts[71] = slPts[71] + anPts[71]
    slPts[72] = slPts[72] + anPts[72]
    slPts[73] = slPts[73] + anPts[73]
    slPts[74] = slPts[74] + anPts[74]
    slPts[75] = slPts[75] + anPts[75]
    slPts[76] = slPts[76] + anPts[76]
    slPts[77] = slPts[77] + anPts[77]
    slPts[78] = slPts[78] + anPts[78]
