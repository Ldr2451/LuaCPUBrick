      let sidx57 = (sp57 | 0)
      let qx57 = if cornerAX < 0.5 then MGX + (sx57 + 0.0) * CELL else 0.0 - (MGX + (sx57 + 0.0) * CELL)
      let qy57 = if cornerAY < 0.5 then MGY + (sy57 + 0.0) * CELL else 0.0 - (MGY + (sy57 + 0.0) * CELL)
      DisplayText(ctrl, "█", positionX = qx57, positionY = qy57, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx57], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx57)
      let sp58 = if s + 58.0 >= NPF then s + 58.0 - NPF else s + 58.0
      let sy58 = ((sp58 / SWF) | 0)
      let sx58 = ((sp58 - (sy58 + 0.0) * SWF) | 0)
      let sidx58 = (sp58 | 0)
      let qx58 = if cornerAX < 0.5 then MGX + (sx58 + 0.0) * CELL else 0.0 - (MGX + (sx58 + 0.0) * CELL)
      let qy58 = if cornerAY < 0.5 then MGY + (sy58 + 0.0) * CELL else 0.0 - (MGY + (sy58 + 0.0) * CELL)
      DisplayText(ctrl, "█", positionX = qx58, positionY = qy58, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx58], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx58)
      let sp59 = if s + 59.0 >= NPF then s + 59.0 - NPF else s + 59.0
      let sy59 = ((sp59 / SWF) | 0)
      let sx59 = ((sp59 - (sy59 + 0.0) * SWF) | 0)
      let sidx59 = (sp59 | 0)
      let qx59 = if cornerAX < 0.5 then MGX + (sx59 + 0.0) * CELL else 0.0 - (MGX + (sx59 + 0.0) * CELL)
      let qy59 = if cornerAY < 0.5 then MGY + (sy59 + 0.0) * CELL else 0.0 - (MGY + (sy59 + 0.0) * CELL)
      DisplayText(ctrl, "█", positionX = qx59, positionY = qy59, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx59], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx59)
      let sp60 = if s + 60.0 >= NPF then s + 60.0 - NPF else s + 60.0
      let sy60 = ((sp60 / SWF) | 0)
      let sx60 = ((sp60 - (sy60 + 0.0) * SWF) | 0)
      let sidx60 = (sp60 | 0)
      let qx60 = if cornerAX < 0.5 then MGX + (sx60 + 0.0) * CELL else 0.0 - (MGX + (sx60 + 0.0) * CELL)
      let qy60 = if cornerAY < 0.5 then MGY + (sy60 + 0.0) * CELL else 0.0 - (MGY + (sy60 + 0.0) * CELL)
      DisplayText(ctrl, "█", positionX = qx60, positionY = qy60, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx60], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx60)
      let sp61 = if s + 61.0 >= NPF then s + 61.0 - NPF else s + 61.0
      let sy61 = ((sp61 / SWF) | 0)
      let sx61 = ((sp61 - (sy61 + 0.0) * SWF) | 0)
      let sidx61 = (sp61 | 0)
      let qx61 = if cornerAX < 0.5 then MGX + (sx61 + 0.0) * CELL else 0.0 - (MGX + (sx61 + 0.0) * CELL)
      let qy61 = if cornerAY < 0.5 then MGY + (sy61 + 0.0) * CELL else 0.0 - (MGY + (sy61 + 0.0) * CELL)
      DisplayText(ctrl, "█", positionX = qx61, positionY = qy61, anchorX = cornerAX, anchorY = cornerAY, fontColor = fb[sidx61], fontSize = FSIZE, lifetime = LIFE, textId = TIDB + sidx61)
      let sp62 = if s + 62.0 >= NPF then s + 62.0 - NPF else s + 62.0
      let sy62 = ((sp62 / SWF) | 0)
      let sx62 = ((sp62 - (sy62 + 0.0) * SWF) | 0)
      let sidx62 = (sp62 | 0)
      let qx62 = if cornerAX < 0.5 then MGX + (sx62 + 0.0) * CELL else 0.0 - (MGX + (sx62 + 0.0) * CELL)
      let qy62 = if cornerAY < 0.5 then MGY + (sy62 + 0.0) * CELL else 0.0 - (MGY + (sy62 + 0.0) * CELL)
