      let oy2 = if cornerAY < 0.5 then MGY + ly2 * CELL else 0.0 - (MGY + ly2 * CELL)
      DisplayText(ctrl, "█", positionX = ox2, positionY = oy2, anchorX = cornerAX, anchorY = cornerAY, fontColor = pCol, fontSize = FSIZE, lifetime = LIFE, textId = TIDB + ridx2)
